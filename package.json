{
  "name": "@aefree/pi-onepassword",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/bash-op-guard.ts"
    ]
  },
  "scripts": {
    "test": "tsx tests/bash-op-guard-validation.ts && tsx tests/trusted-op-run-validation.ts && tsx tests/fixed-authenticated-read-validation.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  },
  "description": "Least-privilege 1Password helpers and Bash safety policy for Pi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aefreedman/pi-onepassword.git"
  },
  "bugs": {
    "url": "https://github.com/aefreedman/pi-onepassword/issues"
  },
  "homepage": "https://github.com/aefreedman/pi-onepassword#readme",
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
