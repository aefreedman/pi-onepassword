{
  "name": "@aefree/pi-onepassword",
  "version": "0.2.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/bash-op-guard.ts"
    ]
  },
  "scripts": {
    "test": "tsx tests/bash-op-guard-validation.ts && tsx tests/bash-op-guard-extension-validation.ts && tsx tests/trusted-op-run-validation.ts && tsx tests/supported-surface-validation.ts",
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run --json",
    "pack:validate": "node scripts/validate-pack-manifest.mjs",
    "pack:smoke": "node scripts/packed-tarball-smoke.mjs",
    "scan:sensitive": "node scripts/validate-sensitive-content.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "22.19.19",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  },
  "description": "Least-privilege 1Password helpers and Bash safety policy for Pi.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aefreedman/pi-onepassword.git"
  },
  "bugs": {
    "url": "https://github.com/aefreedman/pi-onepassword/issues"
  },
  "homepage": "https://github.com/aefreedman/pi-onepassword#readme",
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
